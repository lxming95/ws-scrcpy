# ============================================
# 阶段一：构建阶段（生成 dist）
# ============================================
FROM arm32v7/node:16-bullseye AS builder

WORKDIR /app

# 复制依赖清单
COPY package*.json ./

# 跳过 postinstall 脚本，避免 setup-appium.js 报错
RUN npm config set ignore-scripts true

# 安装全部依赖（含 webpack 等 devDependencies）
RUN npm install

# 复制源码并编译，生成 dist 目录
COPY . .
RUN npm run dist

# 验证 dist 是否真的生成了（构建时就能发现问题）
RUN ls -la /app/dist/ && test -f /app/dist/index.js

# ============================================
# 阶段二：运行阶段（只运行，不编译）
# ============================================
FROM arm32v7/node:16-bullseye-slim

WORKDIR /app

# 复制编译产物和依赖
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package.json ./package.json

# 关键：直接运行编译产物，绕过 npm start 里的 npm run dist
WORKDIR /app/dist
EXPOSE 8000
CMD ["node", "index.js"]
