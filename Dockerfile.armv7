# ============================================
# 阶段一：构建阶段（生成 dist 和编译原生模块）
# ============================================
FROM arm32v7/node:16-bullseye AS builder

# 安装 node-pty 等原生模块编译所需的工具链
RUN apt-get update && apt-get install -y \
    python3 \
    make \
    g++ \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# 复制依赖清单
COPY package*.json ./

# 删除 postinstall 脚本，避免 setup-appium.js 执行导致 MODULE_NOT_FOUND
# 使用 npm pkg delete（npm 7+ 支持），如果失败也不影响后续
RUN npm pkg delete scripts.postinstall || true

# 安装全部依赖（含 devDependencies，webpack 在其中）
# 此时 node-pty 的 install 脚本会正常执行并编译出 pty.node
RUN npm install

# 复制源码并编译，生成 dist 目录
COPY . .
RUN npm run dist

# 可选：验证 dist 和 pty.node 是否生成
RUN ls -la /app/dist/index.js && \
    ls -la /app/node_modules/node-pty/build/Release/pty.node

# ============================================
# 阶段二：运行阶段（只运行，不编译）
# ============================================
FROM arm32v7/node:16-bullseye-slim

# 安装 adb，用于与 USB 连接的手机通信
RUN apt-get update && apt-get install -y \
    android-tools-adb \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# 从构建阶段复制完整产物（node_modules 已包含编译好的 pty.node）
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package.json ./package.json

# 关键：直接运行编译产物，绕过 npm start 里的 npm run dist
WORKDIR /app/dist
EXPOSE 8000
CMD ["node", "index.js"]
