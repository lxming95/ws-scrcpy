# ============================================
# 阶段一：构建阶段
# ============================================
FROM arm32v7/node:16-bullseye AS builder

WORKDIR /app

# 复制依赖清单
COPY package*.json ./

# 关键：跳过 postinstall 脚本，避免 setup-appium.js 报错
RUN npm config set ignore-scripts true

# 安装依赖
RUN npm install --production

# 复制源码并编译
COPY . .
RUN npm run dist

# ============================================
# 阶段二：运行阶段
# ============================================
FROM arm32v7/node:16-bullseye-slim

WORKDIR /app

# 只拷贝必要产物
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package.json ./

WORKDIR /app/dist
EXPOSE 8000
CMD ["node", "index.js"]
